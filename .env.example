# Optional: ScraperAPI key. Used for Amazon (src/lib/scraper.ts, /api/amazon-proxy) and as the
# fallback for other stores that block direct requests (e.g. Cloudflare-protected shops like
# Scorptec) or need JavaScript rendering. Ordinary stores are fetched directly and cost no credits.
# Without it, Amazon is fetched directly (free, but blocked more easily).
SCRAPER_API=

# Required: URL of your PocketBase instance.
NEXT_PUBLIC_POCKETBASE_URL=

# Required: secret checked against the Authorization header on /api/cron/refresh-products.
# Vercel sets this automatically as `Bearer $CRON_SECRET` when invoking Cron Jobs —
# just add CRON_SECRET as a project env var and it's wired up for you. Without it,
# the cron endpoint refuses to run.
CRON_SECRET=

# Optional: shared secret checked against the x-scrape-secret header on /api/scrape.
# Set both of these to the same value to require it (NEXT_PUBLIC_ is exposed to the
# browser bundle since WebScraper.tsx calls /api/scrape client-side — this deters
# casual/automated abuse of your ScraperAPI quota, not a targeted attacker).
SCRAPE_SECRET=
NEXT_PUBLIC_SCRAPE_SECRET=
# (The same secret also protects /api/scrape/html, which saves pages fetched via the local helper.)

# Optional: where the browser finds the local fetch helper (see README, "Local fetch helper").
# Defaults to http://127.0.0.1:4545.
NEXT_PUBLIC_LOCAL_FETCHER_URL=
