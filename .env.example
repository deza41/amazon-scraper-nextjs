# Optional: ScraperAPI key used by src/lib/scraper.ts and the /api/amazon-proxy route.
# Without it, the scraper falls back to fetching Amazon directly (free, but blocked more easily).
SCRAPER_API=

# Optional: override the default PocketBase instance (https://straight-gass.pockethost.io)
NEXT_PUBLIC_POCKETBASE_URL=

# Optional: secret checked against the Authorization header on /api/cron/refresh-products.
# Vercel sets this automatically as `Bearer $CRON_SECRET` when invoking Cron Jobs —
# just add CRON_SECRET as a project env var and it's wired up for you.
CRON_SECRET=
